{
  "$schema": "./node_modules/markdownlint-cli2/schema/markdownlint-cli2-config-schema.json",
  "config": {
    "default": true,
    // Tables frequently cause long line lengths
    "MD013": false,
    // The changelog repeats "Added", "Changed", and so on under each version
    "MD024": { "siblings_only": true }
  },
  "customRules": ["./scripts/markdownlint-intro-before-subheading.ts"],
  // `**` skips dot folders, so .github is listed on its own.
  "globs": ["**/*.md", ".github/**/*.md"],
  "overrides": [
    {
      // GitHub prefills the pull request body with this; it has no title.
      "filter": [".github/PULL_REQUEST_TEMPLATE.md"],
      "config": { "MD041": false },
      "combine": "merge"
    },
    {
      // The Contributor Covenant's own text, kept as published.
      "filter": ["CODE_OF_CONDUCT.md"],
      "config": { "intro-before-subheading": false },
      "combine": "merge"
    }
  ],
  "gitignore": true
}
